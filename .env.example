# Copy this file to .env and fill in your own values. Never share .env.

# Gmail SMTP
SMTP_EMAIL=yourgmail@gmail.com
SMTP_APP_PASSWORD=your_16_character_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Meta WhatsApp Cloud API (use credentials from Meta Developer dashboard)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# For free-form text, the recipient must have messaged the business within the allowed customer-service window.
WHATSAPP_MODE=text
# For business-initiated alerts, set WHATSAPP_MODE=template and use an approved template name.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Twilio SMS (real SMS can cost money; trial restrictions apply)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
